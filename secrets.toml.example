# ============================================
# このファイルを「secrets.toml」という名前にコピーして書き換えてください。
# Streamlit Cloud の場合は Settings → Secrets にこの内容を貼り付け。
#
# ★重要★ admin_password は必ず [smtp] より「上」に書くこと！
#   （[smtp] より下に書くと smtp の設定として扱われてしまいます）
# ============================================

admin_password = "ここにお好きなパスワード"

[smtp]
host = "smtp.gmail.com"
port = 465
user = "あなたのアドレス@gmail.com"
password = "Gmailのアプリパスワード16桁"
to_email = "あなたのアドレス@gmail.com"
